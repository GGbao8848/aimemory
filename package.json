{
  "name": "aimemory",
  "version": "0.2.0",
  "description": "aimemory —— 个人自托管的 AI 记忆库：mem0 形态（add/search/history + 冲突消解 + 向量检索）+ MCP + Web 管理台",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "doctor": "node scripts/doctor.js",
    "types": "node scripts/gen-api-types.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "test": "node --test",
    "vec:rebuild": "node scripts/vec-rebuild.js",
    "classify:backfill": "node scripts/classify-backfill.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  }
}
