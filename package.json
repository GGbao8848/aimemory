{
  "name": "aimemory",
  "version": "0.2.0",
  "description": "aimemory —— 个人自托管的 AI 记忆库：mem0 兼容 MCP 服务 + 四层记忆（L0 会话归档 / L2 事实记忆）+ Web 管理平台",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "doctor": "node scripts/doctor.js",
    "types": "node scripts/gen-api-types.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "collector": "node collector/index.js",
    "collector:status": "node collector/index.js --status",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  }
}
