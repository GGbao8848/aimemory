# ===== aimemory 服务 =====
# 监听端口（内网单端口：/mcp + /api + Web 管理页共用）
PORT=18543
# 服务对外地址（用于 Web 页面生成 MCP 配置 JSON 的 url 字段；留空则用请求来源 Host）
PUBLIC_BASE_URL=

# ===== Keycloak（对接 mykeycloak 部署，见 mykeycloak/README.md）=====
# 迁移到其他公司/服务器时，只需改这里的 URL 即可对接任意主机/端口的 Keycloak；
# 服务运行期通过 OIDC 发现端点自动获取公钥与端点，无需管理员权限。
KEYCLOAK_URL=http://localhost:18443
KEYCLOAK_REALM=aimemory
KEYCLOAK_CLIENT_ID=aimemory

# ===== Keycloak 初始化（scripts/setup-keycloak.mjs 使用，master realm 管理凭据）=====
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dd058d25e0689876395d3ba3ffe636f9
# 测试用户（验证多租户隔离）
TEST_USERS=alice,bob,charlie
TEST_USERS_PASSWORD=aimemory-test-2026

# ===== 会话 =====
# Web 登录会话 cookie 签名密钥（首次部署自动生成并写回 .env；也可手动设置）
SESSION_SECRET=

# ===== Embedding 语义检索（可选，P0-1）=====
# EMBEDDING_ENABLED=1 时启用 search_memories 的语义召回；未配置/失败时自动回退关键词检索。
# 指向任意 OpenAI 兼容的 /v1/embeddings 服务（vLLM / llama.cpp / OpenAI 兼容网关）。
EMBEDDING_ENABLED=0
EMBEDDING_BASE_URL=http://10.10.10.146:8005/v1
EMBEDDING_MODEL=/models/Qwen3-Embedding-8B
EMBEDDING_API_KEY=brsys-2026
# 单次 embedding 调用超时（毫秒）
EMBEDDING_TIMEOUT_MS=15000

# ===== LLM（infer 事实抽取，可选，P0-2）=====
# LLM_ENABLED=1 时 add_memory 的 infer 生效（默认）；失败自动降级原样入库。
# 指向任意 OpenAI 兼容的 /v1/chat/completions 服务。
LLM_ENABLED=0
LLM_BASE_URL=http://10.10.10.146:8001/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=30000
