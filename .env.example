# ===== aimemory 服务（多租户，mem0 形态）=====
# 监听端口（单端口：/mcp + /v1 /v2 API + Web 管理页共用）
PORT=18543

# ===== Keycloak 登录（Web 管理台必配）=====
# 与 BR-Agent 多租户部署共用同一 Keycloak（SSO 会话 cookie 按 host 域共享，
# KEYCLOAK_URL 必须与 BR-Agent 配同一 host）。client 注册：node scripts/setup-keycloak.mjs
KEYCLOAK_URL=http://<keycloak-host>:8666
KEYCLOAK_REALM=br
KEYCLOAK_CLIENT_ID=aimemory-web
# master realm 管理员（仅 setup-keycloak.mjs 注册 client 时使用，服务运行不需要）
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# setup-keycloak.mjs 可选：逗号分隔的测试用户清单（留空=不创建，br 域用户由多租户统一管理）
# TEST_USERS=
# TEST_USERS_PASSWORD=
# 反向代理/容器部署时对外可达地址（拼 OIDC 回调用；直连部署可留空）
# PUBLIC_BASE_URL=http://aimemory.example.com

# ===== 存量单用户数据（迁移用）=====
# v0.2 单用户时代的身份常量，仅供 scripts/migrate-owner-data.mjs 定位旧数据，
# 不再参与鉴权；迁移完成后可不管。
# AIMEMORY_USER_ID=owner
AIMEMORY_USER_NAME=我

# ===== 数据库 =====
# 数据库文件路径（默认 data/aimemory.db；测试可指向独立临时库，避免污染生产数据）
# AIMEMORY_DB=/path/to/test.db

# ===== Embedding 语义检索（可选）=====
# EMBEDDING_ENABLED=1 时启用语义召回；未配置/失败时自动回退关键词检索。
# 指向任意 OpenAI 兼容的 /v1/embeddings 服务（vLLM / llama.cpp / OpenAI 兼容网关）。
EMBEDDING_ENABLED=0
EMBEDDING_BASE_URL=http://127.0.0.1:8005/v1
EMBEDDING_MODEL=/models/Qwen3-Embedding-8B
EMBEDDING_API_KEY=
# 单次 embedding 调用超时（毫秒）
EMBEDDING_TIMEOUT_MS=15000
# 半熔断：连续失败 N 次进入熔断（期间零请求自动降级关键词），每 RETRY_MS 放行一次探测自动恢复
EMBEDDING_BREAK_THRESHOLD=3
EMBEDDING_RETRY_MS=60000
# 首次启用或换 embedding 模型后：npm run vec:rebuild 重建向量索引（换模型加 -- --reset）

# ===== LLM（素材提炼，必需）=====
# add 收到的素材由它提炼成结构化记忆；未启用时写入会被拒绝。
# 指向任意 OpenAI 兼容的 /v1/chat/completions 服务。
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=30000

# ===== 敏感内容策略（提炼层执行）=====
# allow（默认）：本服务定位内网自托管（本地模型），凭据/密码/密钥可按原文入库
# redact：提炼时把凭据脱敏为「<类型>已脱敏（存放位置: …）」，公网/多人共享部署建议启用
# 只影响 infer=true 提炼产物；infer=false 直存不经此策略
SENSITIVE_MODE=allow

# ===== 服务行为 =====
# /healthz 积压告警阈值：提炼队列 pending 达到该值时判定 degraded（0 = 关闭）
EVENTS_BACKLOG_WARN=50

# ===== 冲突消解（mem0 的 ADD/UPDATE/DELETE/NOOP 语义）=====
# 写入时与已有记忆比对，避免同一事实反复入库；同时覆盖更新路径：
# update 改文本后异步做一次"同一事实"检测（重复的旧候选被合并删除，历史可追溯）。
# 关闭（=0）→ 退化为纯追加。
L2_RECONCILE=1
# 向量索引（sqlite-vec）：扩展缺失或维度不匹配时自动降级，不影响功能
L2_VEC=1
# 单批判定的事实条数 / 每条召回的候选数 / 候选池总量 / 单批删除上限（token 预算硬约束）
L2_MAX_FACTS=20
L2_MAX_CANDIDATES=6
L2_MAX_CANDIDATES_TOTAL=30
L2_MAX_DELETES=5
# 单条文本进 prompt 的裁剪长度 / 判定输出上限
L2_CLIP=200
L2_MAX_TOKENS=800
# 长期价值门槛（1~10，写入时由标注 LLM 给每条事实评分，低于阈值不入库；宁缺毋滥防记忆库污染）
# 例如：评 4 分表示"明显有跨会话价值"；调低收得更宽、调高更严。标注失败时不过滤（fail-open）
L2_MIN_IMPORTANCE=4

# ===== 素材原文归档 =====
# 提交的素材原文随受理落档（raw_materials 表，与记忆库分离、不参与检索），供提炼有损时回溯。
# 保留天数，到期自动清理；设为零以外的值即启用。填 NEGATIVE 不会启用。设为很大数字可近似永久保留。
RAW_ARCHIVE_DAYS=90
