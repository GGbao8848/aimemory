# ===== aimemory 服务（个人自托管，mem0 形态）=====
# 监听端口（单端口：/mcp + /v1 /v2 API + Web 管理页共用）
PORT=18543

# ===== 单用户身份 =====
# 所有数据归属这一个身份。全新部署用默认值即可，无需修改。
# AIMEMORY_USER_ID=owner
# Web 界面显示的名字
AIMEMORY_USER_NAME=我

# ===== Web 登录口令 =====
# 首次启动若为空会自动生成强口令并写回本文件（同时打印在启动日志里）。
# 也可自行设置一个便于记忆的强口令。
AIMEMORY_PASSWORD=

# ===== 数据库 =====
# 数据库文件路径（默认 data/aimemory.db；测试可指向独立临时库，避免污染生产数据）
# AIMEMORY_DB=/path/to/test.db

# ===== Embedding 语义检索（可选）=====
# EMBEDDING_ENABLED=1 时启用语义召回；未配置/失败时自动回退关键词检索。
# 指向任意 OpenAI 兼容的 /v1/embeddings 服务（vLLM / llama.cpp / OpenAI 兼容网关）。
EMBEDDING_ENABLED=0
EMBEDDING_BASE_URL=http://127.0.0.1:8005/v1
EMBEDDING_MODEL=/models/Qwen3-Embedding-8B
EMBEDDING_API_KEY=
# 单次 embedding 调用超时（毫秒）
EMBEDDING_TIMEOUT_MS=15000
# 半熔断：连续失败 N 次进入熔断（期间零请求自动降级关键词），每 RETRY_MS 放行一次探测自动恢复
EMBEDDING_BREAK_THRESHOLD=3
EMBEDDING_RETRY_MS=60000
# 首次启用或换 embedding 模型后：npm run vec:rebuild 重建向量索引（换模型加 -- --reset）

# ===== LLM（素材提炼，必需）=====
# add 收到的素材由它提炼成结构化记忆；未启用时写入会被拒绝。
# 指向任意 OpenAI 兼容的 /v1/chat/completions 服务。
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=30000

# ===== 服务行为 =====
# /healthz 积压告警阈值：提炼队列 pending 达到该值时判定 degraded（0 = 关闭）
EVENTS_BACKLOG_WARN=50

# ===== 冲突消解（mem0 的 ADD/UPDATE/DELETE/NOOP 语义）=====
# 写入时与已有记忆比对，避免同一事实反复入库；同时覆盖更新路径：
# update 改文本后异步做一次"同一事实"检测（重复的旧候选被合并删除，历史可追溯）。
# 关闭（=0）→ 退化为纯追加。
L2_RECONCILE=1
# 向量索引（sqlite-vec）：扩展缺失或维度不匹配时自动降级，不影响功能
L2_VEC=1
# 单批判定的事实条数 / 每条召回的候选数 / 候选池总量 / 单批删除上限（token 预算硬约束）
L2_MAX_FACTS=20
L2_MAX_CANDIDATES=6
L2_MAX_CANDIDATES_TOTAL=30
L2_MAX_DELETES=5
# 单条文本进 prompt 的裁剪长度 / 判定输出上限
L2_CLIP=200
L2_MAX_TOKENS=800
