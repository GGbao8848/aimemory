# ===== aimemory 服务（个人自托管）=====
# 监听端口（单端口：/mcp + /api + Web 管理页共用）
PORT=18543
# 服务对外地址（用于 Web 页面生成 MCP 配置 JSON 的 url 字段；留空则用请求来源 Host）
PUBLIC_BASE_URL=

# ===== 单用户身份 =====
# 所有数据归属这一个身份。全新部署用默认值即可，无需修改。
# AIMEMORY_USER_ID=owner
# Web 界面显示的名字
AIMEMORY_USER_NAME=我

# ===== Web 登录口令 =====
# 首次启动若为空会自动生成强口令并写回本文件（同时打印在启动日志里）。
# 也可自行设置一个便于记忆的强口令。
AIMEMORY_PASSWORD=

# ===== 数据库 =====
# 数据库文件路径（默认 data/aimemory.db；测试可指向独立临时库，避免污染生产数据）
# AIMEMORY_DB=/path/to/test.db
# L0 会话归档目录（默认 data/l0）
# AIMEMORY_L0_DIR=/path/to/l0

# ===== Embedding 语义检索（可选）=====
# EMBEDDING_ENABLED=1 时启用 search_memories 的语义召回；未配置/失败时自动回退关键词检索。
# 指向任意 OpenAI 兼容的 /v1/embeddings 服务（vLLM / llama.cpp / OpenAI 兼容网关）。
EMBEDDING_ENABLED=0
EMBEDDING_BASE_URL=http://127.0.0.1:8005/v1
EMBEDDING_MODEL=/models/Qwen3-Embedding-8B
EMBEDDING_API_KEY=
# 单次 embedding 调用超时（毫秒）
EMBEDDING_TIMEOUT_MS=15000

# ===== LLM（素材提炼，必需）=====
# add_memory 收到的素材由它提炼成结构化记忆；未启用时写入会被拒绝。
# 指向任意 OpenAI 兼容的 /v1/chat/completions 服务。
LLM_ENABLED=1
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
# 单次 LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=30000

# ===== L2 事实记忆：冲突消解与派生 =====
# 详见 docs/L2-事实记忆与冲突消解.md。两个开关都可单独关闭（=0）回退到改动前的纯追加行为。
# 冲突消解：写入时与已有记忆比对（ADD/UPDATE/DELETE/NOOP），避免同一事实反复入库
L2_RECONCILE=1
# 派生：把 L1 会话摘要派生成长期事实（补齐"上层可从 L0 重放"的派生链）
L2_DERIVE=1
# 向量索引（sqlite-vec）：扩展缺失或维度不匹配时自动降级，不影响功能
L2_VEC=1
# 单批判定的事实条数 / 每条召回的候选数 / 候选池总量 / 单批删除上限（token 预算硬约束）
L2_MAX_FACTS=20
L2_MAX_CANDIDATES=6
L2_MAX_CANDIDATES_TOTAL=30
L2_MAX_DELETES=5
# 单条文本进 prompt 的裁剪长度 / 判定输出上限
L2_CLIP=200
L2_MAX_TOKENS=800
# 派生：L1 摘要再静默多久才处理（防止会话刚摘要就续上、白跑一次）
L2_QUIET_MS=300000
# 派生：每轮处理几个会话 / 单会话重试上限 / 轮询间隔
L2_BATCH=6
L2_MAX_ATTEMPTS=3
L2_INTERVAL_MS=60000

# ===== L3 画像／知识（第一阶段）=====
# 详见 docs/L3-画像与知识层.md。条目存 data/l3/ 的 markdown，人工可编辑；SQLite 只存游标。
# 后台凝练开关：攒够 L3_BATCH_NEW 个新消化会话才跑一轮（低频是硬要求，省 token）
L3_DERIVE=1
L3_BATCH_NEW=5
# 单轮最多带几个摘要 / 几条现有条目；摘要与条目的单条裁剪长度
L3_MAX_SUMMARIES=8
L3_MAX_ENTRIES=20
L3_CLIP=300
L3_ENTRY_CLIP=120
# L2 事实采样（仅作凝练背景，不进条目）：条数与单条裁剪
L3_MAX_FACTS_SAMPLE=10
L3_FACT_CLIP=80
L3_MAX_TOKENS=600
# L3 置信度时效衰减的半衰期（天）：条目越久远有效置信越低（只读视图，文件原值不动）；0 = 关衰减
L3_HALF_LIFE_DAYS=180
L3_INTERVAL_MS=600000
