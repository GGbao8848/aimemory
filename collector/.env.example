# ===== aimemory 采集器（装在要采集的机器上）=====
# 加载规则：真环境变量 > 本文件（collector/.env）> config.json（安装流程写入）> 内置默认值。
# 复制使用：cp collector/.env.example collector/.env

# 服务端地址（必填；aimemory 服务所在机器）
AIMEMORY_SERVER_URL=
# 上传 Token（必填；服务端 /admin「接入 Token」页签发，或走设备流授权）
AIMEMORY_TOKEN=

# 采集哪些 agent（逗号分隔：codex,claude,zcode；默认三家全采）
# AIMEMORY_COLLECTOR_AGENTS=codex,claude,zcode

# 设备身份（一般留空：首启自动生成设备码并落盘；label 用于界面展示）
# AIMEMORY_DEVICE_LABEL=
# AIMEMORY_DEVICE_CODE=
# 兼容字段（缺省即设备码，无需设置）
# AIMEMORY_COLLECTOR_ID=

# ===== 节奏与批次 =====
# 采集轮询间隔（毫秒）
# AIMEMORY_POLL_MS=15000
# 单批条数 / 单批字节上限（2MB）/ 队列积压上限批数（超过则本轮只上传不采集——背压）
# AIMEMORY_BATCH_RECORDS=500
# AIMEMORY_BATCH_BYTES=2097152
# AIMEMORY_MAX_QUEUED=300
# 上传重试：最大次数 / 退避起点（毫秒）/ 退避上限（毫秒）
# AIMEMORY_RETRY_MAX=5
# AIMEMORY_RETRY_BASE_MS=1000
# AIMEMORY_RETRY_MAX_MS=60000

# ===== 采集范围与保真 =====
# 保留原始行（L0 是事实源；关掉可省约一半体积但会丢字段，不建议）
# AIMEMORY_KEEP_RAW=1
# 各 agent 会话目录覆盖（非标准安装才需要）
# CODEX_HOME=
# CLAUDE_CONFIG_DIR=
# ZCODE_HOME=

# ===== 路径覆盖（一般无需设置）=====
# state 目录（游标/队列/设备身份落盘处；默认 ~/.aimemory-collector）
# AIMEMORY_COLLECTOR_DIR=
# config.json 路径覆盖
# AIMEMORY_COLLECTOR_CONFIG=
# 本文件自身路径覆盖（测试用）
# AIMEMORY_COLLECTOR_DOTENV=
